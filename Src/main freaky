static float clampf(float v, float lo, float hi)
{ return (v < lo) ? lo : (v > hi) ? hi : v; }

static float smoothstep(float x)
{ x = clampf(x, 0.0f, 1.0f); return x * x * (3.0f - 2.0f * x); }

static float apply_inv(float deg, int inv)
{ return inv ? (180.0f - deg) : deg; }

static float angle_to_us(float deg, float mn, float mx)
{ deg = clampf(deg, 0.0f, 180.0f); return mn + (deg / 180.0f) * (mx - mn); }

static void write_servo(uint8_t ch, float deg, float mn, float mx)
{
  if (PCA9685_SetServoPulseUs(&pca, ch, (uint16_t)angle_to_us(deg, mn, mx)) != HAL_OK) {
    if (++g_servo_faults >= SERVO_FAULT_MAX) {
      gait.running = 0;
      UART_Sendf("SERVO FAULT ch%u: gait stopped\r\n", (unsigned)ch);
    }
  } else {
    g_servo_faults = 0;
  }
}

static void all_full_off(void)
{
  uint8_t chs[] = { FR_HIP_CH, FR_KNEE_CH, FR_EXT_CH,
                    FL_HIP_CH, FL_KNEE_CH, FL_EXT_CH,
                    BR_HIP_CH, BR_KNEE_CH,
                    BL_HIP_CH, BL_KNEE_CH };
  for (int i = 0; i < (int)(sizeof(chs) / sizeof(chs[0])); i++) {
    (void)PCA9685_SetChannelFullOff(&pca, chs[i], 1);
  }
}

static void enable_extension_channels(void)
{
  (void)PCA9685_SetChannelFullOff(&pca, FR_EXT_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, FL_EXT_CH, 0);
}

static void set_extensions_neutral(void)
{
  /* Front extension calibration: FR holds near 5 deg, FL needs 90 deg on this robot. */
  enable_extension_channels();
  write_servo(FR_EXT_CH, apply_inv(FR_EXT_NEUTRAL + FR_EXT_TRIM, FR_EXT_INV), EXT_MIN_US, EXT_MAX_US);
  write_servo(FL_EXT_CH, apply_inv(FL_EXT_NEUTRAL + FL_EXT_TRIM, FL_EXT_INV), EXT_MIN_US, EXT_MAX_US);
}

static void enable_hip_knee_channels(void)
{
  (void)PCA9685_SetChannelFullOff(&pca, FR_HIP_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, FR_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, FL_HIP_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, FL_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, BR_HIP_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, BR_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, BL_HIP_CH, 0);
  (void)PCA9685_SetChannelFullOff(&pca, BL_KNEE_CH, 0);
}

static void enable_all_servo_channels(void)
{
  enable_hip_knee_channels();
  enable_extension_channels();
}

static void UART_Sendf(const char *fmt, ...)
{
  char buf[160];
  va_list ap;
  va_start(ap, fmt);
  int len = vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);
  if (len <= 0) return;
  if (len > (int)(sizeof(buf) - 1)) len = (int)(sizeof(buf) - 1);

  for (int i = 0; i < len; i++) {
    uint16_t next = (uint16_t)((uart_tx_head + 1U) % UART_TX_BUF_SIZE);
    if (next != uart_tx_tail) {
      uart_tx_buf[uart_tx_head] = (uint8_t)buf[i];
      uart_tx_head = next;
    }
  }
}

static void UART_TxService(void)
{
  while (uart_tx_head != uart_tx_tail && __HAL_UART_GET_FLAG(&huart2, UART_FLAG_TXE)) {
    huart2.Instance->DR = uart_tx_buf[uart_tx_tail];
    uart_tx_tail = (uint16_t)((uart_tx_tail + 1U) % UART_TX_BUF_SIZE);
  }
}

static int UART_TryReadLine(char out[UART_LINE_MAX])
{
  static char line[UART_LINE_MAX];
  static uint8_t idx = 0;
  uint8_t b = 0;

  if (HAL_UART_Receive(&huart2, &b, 1, UART_BYTE_TIMEOUT_MS) != HAL_OK) return 0;
  if (b == '\r') return 0;

  if (b == '\n') {
    line[idx] = '\0';
    strncpy(out, line, UART_LINE_MAX);
    out[UART_LINE_MAX - 1] = '\0';
    idx = 0;
    return 1;
  }

  if (idx < UART_LINE_MAX - 1) line[idx++] = (char)b;
  else idx = 0;
  return 0;
}

static void str_to_upper(char *s)
{
  while (*s) {
    *s = (char)toupper((unsigned char)*s);
    s++;
  }
}

static void Gait_Init(void)
{
  gait.running = 0;
  gait.dir = +1;
  gait.yaw = 0.0f;
  gait.ramp_start_ms = 0;
  gait.t0 = 0;
}

static void gait_compute_leg(float phase, float hip_n, float knee_n,
                             float dir, float amp,
                             float *hip_out, float *knee_out)
{
  float hip, knee;

  if (phase < STANCE_END_PHASE) {
    float u = smoothstep(phase / STANCE_END_PHASE);
    hip  = hip_n - dir * amp * (2.0f * u - 1.0f);
    knee = knee_n + KNEE_STANCE_BEND;
  } else {
    float u    = (phase - STANCE_END_PHASE) / (1.0f - STANCE_END_PHASE);
    float s    = smoothstep(u);
    float lift = (u < 0.5f) ? smoothstep(u * 2.0f) : smoothstep((1.0f - u) * 2.0f);
    hip  = hip_n + dir * amp * (2.0f * s - 1.0f);
    knee = knee_n + KNEE_BEND_AMP * lift;
  }

  *hip_out  = clampf(hip, 0.0f, 180.0f);
  *knee_out = clampf(knee, 0.0f, 180.0f);
}

static void Gait_Tick(float dt_ms)
{
  (void)dt_ms;
  if (!gait.running) return;

  uint32_t now = HAL_GetTick();
  if (gait.t0 == 0U) gait.t0 = now;

  float phase_a = (float)((now - gait.t0) % STEP_PERIOD_MS) / (float)STEP_PERIOD_MS;
  float phase_b = phase_a + DIAG_DELAY_PHASE;
  if (phase_b >= 1.0f) phase_b -= 1.0f;

  float ramp = smoothstep(clampf((float)(now - gait.ramp_start_ms) / (float)GAIT_RAMP_MS,
                                 0.0f, 1.0f));
  float dir = (float)gait.dir;

  float a_dir, b_dir, a_amp, b_amp;
  if (dir == 0.0f) {
    a_dir = gait.yaw;
    b_dir = -gait.yaw;
    a_amp = HIP_SWING_AMP;
    b_amp = HIP_SWING_AMP;
  } else {
    a_amp = HIP_SWING_AMP * clampf(1.0f + gait.yaw, 0.0f, 2.0f);
    b_amp = HIP_SWING_AMP * clampf(1.0f - gait.yaw, 0.0f, 2.0f);
    a_dir = dir;
    b_dir = dir;
  }

  float fr_hip, fr_knee, bl_hip, bl_knee;
  float fl_hip, fl_knee, br_hip, br_knee;

  /* True diagonal sync: FR+BL share phase_a, FL+BR share phase_b. */
  gait_compute_leg(phase_a, FR_HIP_NEUTRAL + FR_HIP_TRIM, FR_KNEE_NEUTRAL + FR_KNEE_TRIM,
                   a_dir, a_amp, &fr_hip, &fr_knee);
  gait_compute_leg(phase_a, BL_HIP_NEUTRAL + BL_HIP_TRIM, BL_KNEE_NEUTRAL + BL_KNEE_TRIM,
                   a_dir, a_amp * BL_HIP_AMP_SCALE, &bl_hip, &bl_knee);
  gait_compute_leg(phase_b, FL_HIP_NEUTRAL + FL_HIP_TRIM, FL_KNEE_NEUTRAL + FL_KNEE_TRIM,
                   b_dir, b_amp, &fl_hip, &fl_knee);
  gait_compute_leg(phase_b, BR_HIP_NEUTRAL + BR_HIP_TRIM, BR_KNEE_NEUTRAL + BR_KNEE_TRIM,
                   b_dir, b_amp, &br_hip, &br_knee);

  /* Knee motion disabled: keep all knees locked at neutral during gait. */

#define RAMP_VAL(val, n) ((n) + ramp * ((val) - (n)))
  fr_hip  = RAMP_VAL(fr_hip,  FR_HIP_NEUTRAL + FR_HIP_TRIM);
  bl_hip  = RAMP_VAL(bl_hip,  BL_HIP_NEUTRAL + BL_HIP_TRIM);
  fl_hip  = RAMP_VAL(fl_hip,  FL_HIP_NEUTRAL + FL_HIP_TRIM);
  br_hip  = RAMP_VAL(br_hip,  BR_HIP_NEUTRAL + BR_HIP_TRIM);
#undef RAMP_VAL

  fr_knee = FR_KNEE_NEUTRAL + FR_KNEE_TRIM;
  fl_knee = FL_KNEE_NEUTRAL + FL_KNEE_TRIM;
  br_knee = BR_KNEE_NEUTRAL + BR_KNEE_TRIM;
  bl_knee = BL_KNEE_NEUTRAL + BL_KNEE_TRIM;

  /* Still keep BL hip inside a safe window. */
  bl_hip  = clampf(bl_hip,  BL_HIP_MIN_DEG,  BL_HIP_MAX_DEG);

  /* Write the BL pair first so it gets updated earliest each control cycle. */
  write_servo(BL_HIP_CH,  apply_inv(bl_hip, BL_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BL_KNEE_CH, apply_inv(bl_knee, BL_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FR_HIP_CH,  apply_inv(fr_hip, FR_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FR_KNEE_CH, apply_inv(fr_knee, FR_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BR_HIP_CH,  apply_inv(br_hip, BR_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BR_KNEE_CH, apply_inv(br_knee, BR_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FL_HIP_CH,  apply_inv(fl_hip, FL_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FL_KNEE_CH, apply_inv(fl_knee, FL_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
}

static void Go_To_Neutral(void)
{
  set_extensions_neutral();
  write_servo(BL_HIP_CH,  apply_inv(BL_HIP_NEUTRAL + BL_HIP_TRIM, BL_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BL_KNEE_CH, apply_inv(BL_KNEE_NEUTRAL + BL_KNEE_TRIM, BL_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FR_HIP_CH,  apply_inv(FR_HIP_NEUTRAL + FR_HIP_TRIM, FR_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FR_KNEE_CH, apply_inv(FR_KNEE_NEUTRAL + FR_KNEE_TRIM, FR_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BR_HIP_CH,  apply_inv(BR_HIP_NEUTRAL + BR_HIP_TRIM, BR_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BR_KNEE_CH, apply_inv(BR_KNEE_NEUTRAL + BR_KNEE_TRIM, BR_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FL_HIP_CH,  apply_inv(FL_HIP_NEUTRAL + FL_HIP_TRIM, FL_HIP_INV), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FL_KNEE_CH, apply_inv(FL_KNEE_NEUTRAL + FL_KNEE_TRIM, FL_KNEE_INV), KNEE_MIN_US, KNEE_MAX_US);
}

static void Gait_Start(void)
{
  gait.running = 1;
  gait.ramp_start_ms = HAL_GetTick();
  gait.t0 = 0;
}

static void Gait_Stop(void)
{
  gait.running = 0;
  gait.dir = +1;
  gait.yaw = 0.0f;
  gait.ramp_start_ms = 0;
  gait.t0 = 0;
  Go_To_Neutral();
}

static void Handle_UART(void)
{
  char rx[UART_LINE_MAX];
  if (!UART_TryReadLine(rx)) return;
  str_to_upper(rx);

  if (strcmp(rx, TOKEN_GO) == 0 || strcmp(rx, TOKEN_FWD) == 0) {
    gait.dir = +1;
    gait.yaw = 0.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("FWD\r\n");
  } else if (strcmp(rx, TOKEN_BACK) == 0) {
    gait.dir = -1;
    gait.yaw = 0.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("BACK\r\n");
  } else if (strcmp(rx, TOKEN_LEFT) == 0) {
    gait.yaw = -1.0f;
    if (gait.dir == 0) gait.dir = +1;
    if (!gait.running) Gait_Start();
    UART_Sendf("LEFT\r\n");
  } else if (strcmp(rx, TOKEN_RIGHT) == 0) {
    gait.yaw = +1.0f;
    if (gait.dir == 0) gait.dir = +1;
    if (!gait.running) Gait_Start();
    UART_Sendf("RIGHT\r\n");
  } else if (strcmp(rx, "PIVOT_LEFT") == 0) {
    gait.dir = 0;
    gait.yaw = -1.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("PIVOT_LEFT\r\n");
  } else if (strcmp(rx, "PIVOT_RIGHT") == 0) {
    gait.dir = 0;
    gait.yaw = +1.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("PIVOT_RIGHT\r\n");
  } else if (strcmp(rx, TOKEN_STOP) == 0) {
    Gait_Stop();
    UART_Sendf("STOP ACK\r\n");
  } else {
    UART_Sendf("UNKNOWN: '%s'\r\n", rx);
  }
}

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_I2C3_Init();
  MX_USART2_UART_Init();

  UART_Sendf("\r\nBOOT OK @115200\r\n");

  if (HAL_I2C_IsDeviceReady(&hi2c3, (PCA9685_ADDR_7BIT << 1), 5, 200) != HAL_OK) {
    UART_Sendf("ERROR: PCA9685 not found (I2C3 0x%02X)\r\n", PCA9685_ADDR_7BIT);
    Error_Handler();
  }
  if (PCA9685_Init(&pca, &hi2c3, PCA9685_ADDR_7BIT, 50.0f) != HAL_OK) {
    UART_Sendf("ERROR: PCA9685_Init failed\r\n");
    Error_Handler();
  }

  all_full_off();
  enable_all_servo_channels();
  set_extensions_neutral();
  UART_Sendf("PCA9685 OK\r\n");
  UART_Sendf("Jitter fix applied: channels are enabled once, not re-toggled every control cycle.\r\n");
  UART_Sendf("BL hip strengthened: more swing and wider allowed range.\r\n");
  UART_Sendf("Knee motion disabled: all knees locked at neutral during walking.\r\n");

  Gait_Init();
  Go_To_Neutral();

  UART_Sendf("At neutral. Holding %lu ms before walking...\r\n", (unsigned long)START_HOLD_MS);
  UART_Sendf("Extensions locked at 0 deg during walk.\r\n");
  UART_Sendf("Hip-only walk active. Knees stay at neutral; BR hip inverted so FL+BR match physically.\r\n");
  {
    uint32_t t = HAL_GetTick();
    while ((uint32_t)(HAL_GetTick() - t) < START_HOLD_MS) {
      UART_TxService();
      Handle_UART();
      if (gait.running) break;
    }
  }

  if (!gait.running) {
    Gait_Start();
    UART_Sendf("AUTO WALK START\r\n");
  }

  UART_Sendf("Cmds: GO FWD BACK LEFT RIGHT PIVOT_LEFT PIVOT_RIGHT STOP\r\n");

  uint32_t last_tick = HAL_GetTick();

  while (1) {
    UART_TxService();
    Handle_UART();

    uint32_t now = HAL_GetTick();
    uint32_t dt  = now - last_tick;
    if (dt >= CONTROL_DT_MS) {
      last_tick = now;
      Gait_Tick((float)dt);
    }
  }
}

