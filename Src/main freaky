#define FL_KNEE_CH   6
#define FL_EXT_CH    5

#define BR_HIP_CH    8
#define BR_KNEE_CH   9

#define BL_HIP_CH    12
#define BL_KNEE_CH   13

#define HIP_MIN_US   900.0f
#define HIP_MAX_US   2200.0f
#define KNEE_MIN_US  900.0f
#define KNEE_MAX_US  2200.0f
#define EXT_MIN_US   900.0f
#define EXT_MAX_US   2200.0f

#define FR_HIP_NEUTRAL  60.0f //100
#define FR_KNEE_NEUTRAL   0.0f
#define FR_EXT_NEUTRAL    0.0f
#define FL_HIP_NEUTRAL  130.0f //100
#define FL_KNEE_NEUTRAL   0.0f
#define FL_EXT_NEUTRAL    0.0f
#define BR_HIP_NEUTRAL   130.0f //90
#define BR_KNEE_NEUTRAL  90.0f
#define BL_HIP_NEUTRAL   60.0f //90
#define BL_KNEE_NEUTRAL  40.0f

#define FR_HIP_TRIM   0.0f
#define FR_KNEE_TRIM  0.0f
#define FR_EXT_TRIM   0.0f
#define FR_HIP_INV    0
#define FR_KNEE_INV   0
#define FR_EXT_INV    0

#define FL_HIP_TRIM   0.0f
#define FL_KNEE_TRIM  0.0f
#define FL_EXT_TRIM   0.0f
#define FL_HIP_INV    0
#define FL_KNEE_INV   0
#define FL_EXT_INV    0

#define BR_HIP_TRIM   0.0f
#define BR_KNEE_TRIM  0.0f
#define BR_HIP_INV    1
#define BR_KNEE_INV   0

#define BL_HIP_TRIM   0.0f
#define BL_KNEE_TRIM  0.0f
#define BL_HIP_INV    1
#define BL_KNEE_INV   0

#define CONTROL_DT_MS      20U
#define STEP_PERIOD_MS     1700U
#define START_HOLD_MS      5000U
#define GAIT_RAMP_MS       2200U
#define DIAG_DELAY_PHASE   0.50f
#define STANCE_END_PHASE   0.62f
#define HIP_SWING_AMP      22.0f
#define KNEE_BEND_AMP      48.0f
#define KNEE_STANCE_BEND   12.0f

/* Back-left tuning: remove most of the old damping so BL can keep up. */
#define BL_HIP_AMP_SCALE    1.20f
#define BL_KNEE_AMP_SCALE   1.22f
#define BL_KNEE_STANCE_BOOST 4.0f
#define BL_HIP_MIN_DEG      52.0f
#define BL_HIP_MAX_DEG      128.0f
#define BL_KNEE_MIN_DEG     18.0f
#define BL_KNEE_MAX_DEG     118.0f

