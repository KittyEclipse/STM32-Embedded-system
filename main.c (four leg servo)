static void UART_Sendf(const char *fmt, ...)
{
  char buf[160];
  va_list ap;
  va_start(ap, fmt);
  int len = vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);

  if (len <= 0) return;
  if (len > (int)sizeof(buf)) len = (int)sizeof(buf);
  (void)HAL_UART_Transmit(&huart2, (uint8_t *)buf, (uint16_t)len, 200);
}

static int UART_TryReadLine(char out[UART_LINE_MAX])
{
  static char line[UART_LINE_MAX];
  static uint8_t idx = 0;
  uint8_t b = 0;

  if (HAL_UART_Receive(&huart2, &b, 1, UART_BYTE_TIMEOUT_MS) != HAL_OK)
    return 0;

  if (b == '\r')
    return 0;

  if (b == '\n')
  {
    line[idx] = '\0';
    strncpy(out, line, UART_LINE_MAX);
    out[UART_LINE_MAX - 1] = '\0';
    idx = 0;
    return 1;
  }

  if (idx < (UART_LINE_MAX - 1))
    line[idx++] = (char)b;
  else
    idx = 0;

  return 0;
}

static void str_to_upper(char *s)
{
  while (*s)
  {
    *s = (char)toupper((unsigned char)*s);
    s++;
  }
}

static int UART_WaitForGO_WhileSafeDisabled(void)
{
  char rx[UART_LINE_MAX];
  UART_Sendf("STM32 READY. Send %s\\n to start. Send %s\\n to stop.\r\n", TOKEN_GO, TOKEN_STOP);

  while (1)
  {
    if (UART_TryReadLine(rx))
    {
      str_to_upper(rx);

      if (strcmp(rx, TOKEN_GO) == 0)
      {
        UART_Sendf("CONFIRMED. STARTING WALK.\r\n");
        return 1;
      }
      else if (strcmp(rx, TOKEN_STOP) == 0)
      {
        UART_Sendf("STOP ACK. Outputs remain disabled.\r\n");
      }
      else
      {
        UART_Sendf("UNKNOWN: '%s' (send %s)\r\n", rx, TOKEN_GO);
      }
    }
  }
}

static void gait_compute_leg(float phase,
                             float hip_neutral, float knee_neutral,
                             int dir, float *hip_out, float *knee_out)
{
  const float stance_end = 0.60f;
  float hip = hip_neutral;
  float knee = knee_neutral;

  if (phase < stance_end)
  {
    float u = smoothstep(phase / stance_end);
    hip = hip_neutral - (float)dir * HIP_SWING_AMPL_DEG * (2.0f * u - 1.0f);
    knee = knee_neutral + 7.0f;
  }
  else
  {
    float u = (phase - stance_end) / (1.0f - stance_end);
    float s = smoothstep(u);
    float lift = (u < 0.5f) ? smoothstep(u * 2.0f) : smoothstep((1.0f - u) * 2.0f);

    hip = hip_neutral + (float)dir * HIP_SWING_AMPL_DEG * (2.0f * s - 1.0f);
    knee = knee_neutral + (KNEE_BEND_AMPL_DEG * lift);
  }

  *hip_out = clampf(hip, 0.0f, 180.0f);
  *knee_out = clampf(knee, 0.0f, 180.0f);
}

static void Walking_GaitTask(PCA9685_Handle_t *hpca, uint32_t step_period_ms, int dir)
{
  static uint32_t t0 = 0;
  static uint32_t gait_start_tick = 0;

  if (t0 == 0U)
  {
    const float start_phase = 0.30f;
    uint32_t now_init = HAL_GetTick();
    t0 = now_init - (uint32_t)(start_phase * (float)step_period_ms);
    gait_start_tick = now_init;
  }

  dir = (dir >= 0) ? 1 : -1;

  uint32_t now = HAL_GetTick();
  float phase_a = (float)((now - t0) % step_period_ms) / (float)step_period_ms;
  float phase_b = phase_a + 0.5f;
  if (phase_b >= 1.0f) phase_b -= 1.0f;

  float fr_hip, fr_knee, fl_hip, fl_knee;
  float br_hip, br_knee, bl_hip, bl_knee;

  gait_compute_leg(phase_a, FR_HIP_NEUTRAL_DEG, FR_KNEE_NEUTRAL_DEG, dir, &fr_hip, &fr_knee);
  gait_compute_leg(phase_a, BL_HIP_NEUTRAL_DEG, BL_KNEE_NEUTRAL_DEG, dir, &bl_hip, &bl_knee);
  gait_compute_leg(phase_b, FL_HIP_NEUTRAL_DEG, FL_KNEE_NEUTRAL_DEG, dir, &fl_hip, &fl_knee);
  gait_compute_leg(phase_b, BR_HIP_NEUTRAL_DEG, BR_KNEE_NEUTRAL_DEG, dir, &br_hip, &br_knee);

  float a = smoothstep((float)(now - gait_start_tick) / (float)GAIT_RAMP_MS);

  fr_hip  = FR_HIP_NEUTRAL_DEG + a * (fr_hip  - FR_HIP_NEUTRAL_DEG);
  fr_knee = FR_KNEE_NEUTRAL_DEG + a * (fr_knee - FR_KNEE_NEUTRAL_DEG);
  fl_hip  = FL_HIP_NEUTRAL_DEG + a * (fl_hip  - FL_HIP_NEUTRAL_DEG);
  fl_knee = FL_KNEE_NEUTRAL_DEG + a * (fl_knee - FL_KNEE_NEUTRAL_DEG);
  br_hip  = BR_HIP_NEUTRAL_DEG + a * (br_hip  - BR_HIP_NEUTRAL_DEG);
  br_knee = BR_KNEE_NEUTRAL_DEG + a * (br_knee - BR_KNEE_NEUTRAL_DEG);
  bl_hip  = BL_HIP_NEUTRAL_DEG + a * (bl_hip  - BL_HIP_NEUTRAL_DEG);
  bl_knee = BL_KNEE_NEUTRAL_DEG + a * (bl_knee - BL_KNEE_NEUTRAL_DEG);

  /* Re-assert output enable on every cycle for left hips in case a channel latched off */
  (void)PCA9685_SetChannelFullOff(hpca, FL_HIP_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, BL_HIP_CH, 0);

  FR_SetHipKnee(hpca, fr_hip, fr_knee);
  FL_SetHipKnee(hpca, fl_hip, fl_knee);
  BR_SetHipKnee(hpca, br_hip, br_knee);
  BL_SetHipKnee_Debug(hpca, bl_hip, bl_knee);
}

static void WalkingForward(PCA9685_Handle_t *hpca, uint32_t step_period_ms)
{
  Walking_GaitTask(hpca, step_period_ms, +1);
}

static void WalkingBackward(PCA9685_Handle_t *hpca, uint32_t step_period_ms)
{
  Walking_GaitTask(hpca, step_period_ms, -1);
}

static void PCA_AllOff(PCA9685_Handle_t *hpca)
{
  AllLegs_FullOff(hpca);
}

static void PCA_EnableHipKnee(PCA9685_Handle_t *hpca)
{
  EnableAllHipKnee(hpca);
}

/* Main ---------------------------------------------------------------------*/
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C3_Init();

  UART_Sendf("\r\nBOOT... UART2 OK @115200\r\n");

  if (HAL_I2C_IsDeviceReady(&hi2c3, (PCA9685_ADDR_7BIT << 1), 5, 200) != HAL_OK)
  {
    UART_Sendf("ERROR: PCA9685 not responding\r\n");
    while (1) { }
  }

  if (PCA9685_Init(&pca, &hi2c3, PCA9685_ADDR_7BIT, 50.0f) != HAL_OK)
  {
    UART_Sendf("ERROR: PCA init failed\r\n");
    while (1) { }
  }

  PCA_AllOff(&pca);
  PCA_EnableHipKnee(&pca);
  AllLegs_SetHipKneeNeutral(&pca);
  HAL_Delay(START_HOLD_MS);

  while (1)
  {
    WalkingForward(&pca, STEP_PERIOD_MS);
    HAL_Delay(CONTROL_DT_MS);
  }
}

