{
  (void)PCA9685_SetChannelFullOff(hpca, FR_HIP_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, FR_KNEE_CH, 1);
  (void)PCA9685_SetChannelFullOff(hpca, FR_EXT_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, FL_HIP_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, FL_KNEE_CH, 1);
  (void)PCA9685_SetChannelFullOff(hpca, FL_EXT_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, BR_HIP_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, BR_KNEE_CH, 1);
  (void)PCA9685_SetChannelFullOff(hpca, BL_HIP_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, BL_KNEE_CH, 1);
}

static void EnableAllHipKnee(PCA9685_Handle_t *hpca)
{
  (void)PCA9685_SetPWM(hpca, BL_HIP_CH,  0, 0);
  (void)PCA9685_SetPWM(hpca, BL_KNEE_CH, 0, 0);

  (void)PCA9685_SetChannelFullOff(hpca, FR_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, FR_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, FR_EXT_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, FL_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, FL_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, FL_EXT_CH,  1);
  (void)PCA9685_SetChannelFullOff(hpca, BR_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, BR_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, BL_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, BL_KNEE_CH, 0);
}

static void AllLegs_SetHipKneeNeutral(PCA9685_Handle_t *hpca)
{
  FR_SetHipKnee(hpca, FR_HIP_NEUTRAL_DEG, FR_KNEE_NEUTRAL_DEG);
  FL_SetHipKnee(hpca, FL_HIP_NEUTRAL_DEG, FL_KNEE_NEUTRAL_DEG);
  BR_SetHipKnee(hpca, BR_HIP_NEUTRAL_DEG, BR_KNEE_NEUTRAL_DEG);
  BL_SetHipKnee(hpca, BL_HIP_NEUTRAL_DEG, BL_KNEE_NEUTRAL_DEG);
}

/* ============================================================
   UART helper
   ============================================================ */
static void UART_Sendf(const char *fmt, ...)
{
  char buf[160];
  va_list ap;
  va_start(ap, fmt);
  int len = vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);
  if (len <= 0) return;
  if (len > (int)sizeof(buf)) len = (int)sizeof(buf);
  (void)HAL_UART_Transmit(&huart2, (uint8_t *)buf, (uint16_t)len, 200);
}

/* ============================================================
   Gait core
   ============================================================ */
static void gait_compute_leg(float phase,
                             float hip_neutral, float knee_neutral,
                             int dir, float *hip_out, float *knee_out)
{
  const float stance_end = 0.62f;
  float hip  = hip_neutral;
  float knee = knee_neutral;

  if (phase < stance_end)
  {
    float u = smoothstep(phase / stance_end);
    hip  = hip_neutral - (float)dir * HIP_SWING_AMPL_DEG * (2.0f * u - 1.0f);
    knee = knee_neutral + KNEE_STANCE_BEND_DEG;
  }
  else
  {
    float u    = (phase - stance_end) / (1.0f - stance_end);
    float s    = smoothstep(u);
    float lift = (u < 0.5f) ? smoothstep(u * 2.0f) : smoothstep((1.0f - u) * 2.0f);

    hip  = hip_neutral + (float)dir * HIP_SWING_AMPL_DEG * (2.0f * s - 1.0f);
    knee = knee_neutral + KNEE_BEND_AMPL_DEG * lift;
  }

  *hip_out  = clampf(hip,  0.0f, 180.0f);
  *knee_out = clampf(knee, 0.0f, 180.0f);
}

/* ============================================================
   Walking_GaitTask — lateral pair walk
   Left side : FL + BL together
   Right side: FR + BR together, slightly delayed
   ============================================================ */
static void Walking_GaitTask(PCA9685_Handle_t *hpca, uint32_t step_period_ms, int dir)
{
  static uint32_t t0              = 0;
  static uint32_t gait_start_tick = 0;

  if (t0 == 0U)
  {
    const float start_phase = 0.25f;
    uint32_t now_init = HAL_GetTick();
    t0 = now_init - (uint32_t)(start_phase * (float)step_period_ms);
    gait_start_tick = now_init;
  }

  dir = (dir >= 0) ? 1 : -1;

  uint32_t now = HAL_GetTick();

  float phase_left = (float)((now - t0) % step_period_ms) / (float)step_period_ms;
  float phase_right = phase_left + PAIR_DELAY_PHASE;
  if (phase_right >= 1.0f) phase_right -= 1.0f;

  float fl_hip, fl_knee;
  float bl_hip, bl_knee;
  float fr_hip, fr_knee;
  float br_hip, br_knee;

  gait_compute_leg(phase_left,  FL_HIP_NEUTRAL_DEG, FL_KNEE_NEUTRAL_DEG, dir, &fl_hip, &fl_knee);
  gait_compute_leg(phase_left,  BL_HIP_NEUTRAL_DEG, BL_KNEE_NEUTRAL_DEG, dir, &bl_hip, &bl_knee);
  gait_compute_leg(phase_right, FR_HIP_NEUTRAL_DEG, FR_KNEE_NEUTRAL_DEG, dir, &fr_hip, &fr_knee);
  gait_compute_leg(phase_right, BR_HIP_NEUTRAL_DEG, BR_KNEE_NEUTRAL_DEG, dir, &br_hip, &br_knee);

  {
    float a = smoothstep(clampf((float)(now - gait_start_tick) / (float)GAIT_RAMP_MS,
                                 0.0f, 1.0f));

    fl_hip  = FL_HIP_NEUTRAL_DEG  + a * (fl_hip  - FL_HIP_NEUTRAL_DEG);
    fl_knee = FL_KNEE_NEUTRAL_DEG + a * (fl_knee - FL_KNEE_NEUTRAL_DEG);
    bl_hip  = BL_HIP_NEUTRAL_DEG  + a * (bl_hip  - BL_HIP_NEUTRAL_DEG);
    bl_knee = BL_KNEE_NEUTRAL_DEG + a * (bl_knee - BL_KNEE_NEUTRAL_DEG);
    fr_hip  = FR_HIP_NEUTRAL_DEG  + a * (fr_hip  - FR_HIP_NEUTRAL_DEG);
    fr_knee = FR_KNEE_NEUTRAL_DEG + a * (fr_knee - FR_KNEE_NEUTRAL_DEG);
    br_hip  = BR_HIP_NEUTRAL_DEG  + a * (br_hip  - BR_HIP_NEUTRAL_DEG);
    br_knee = BR_KNEE_NEUTRAL_DEG + a * (br_knee - BR_KNEE_NEUTRAL_DEG);
  }

  (void)PCA9685_SetChannelFullOff(hpca, FL_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, FL_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, BL_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, BL_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, FR_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, FR_KNEE_CH, 0);
  (void)PCA9685_SetChannelFullOff(hpca, BR_HIP_CH,  0);
  (void)PCA9685_SetChannelFullOff(hpca, BR_KNEE_CH, 0);

  FL_SetHipKnee(hpca, fl_hip, fl_knee);
  BL_SetHipKnee(hpca, bl_hip, bl_knee);
  FR_SetHipKnee(hpca, fr_hip, fr_knee);
  BR_SetHipKnee(hpca, br_hip, br_knee);
}

/* ============================================================
   Main
   ============================================================ */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C3_Init();

  UART_Sendf("\r\nBOOT... UART2 OK @115200\r\n");
  UART_Sendf("Gait: FL+BL synced, FR+BR synced\r\n");
  UART_Sendf("Right side delay: %.0f%% of cycle\r\n", (double)(PAIR_DELAY_PHASE * 100.0f));
  UART_Sendf("STEP_PERIOD=%lu ms, CONTROL_DT=%lu ms\r\n",
             (unsigned long)STEP_PERIOD_MS, (unsigned long)CONTROL_DT_MS);

  if (HAL_I2C_IsDeviceReady(&hi2c3, (PCA9685_ADDR_7BIT << 1), 5, 200) != HAL_OK)
  {
    UART_Sendf("ERROR: PCA9685 not responding\r\n");
    while (1) { }
  }

  if (PCA9685_Init(&pca, &hi2c3, PCA9685_ADDR_7BIT, 50.0f) != HAL_OK)
  {
    UART_Sendf("ERROR: PCA init failed\r\n");
    while (1) { }
  }

  AllLegs_FullOff(&pca);
  EnableAllHipKnee(&pca);
  AllLegs_SetHipKneeNeutral(&pca);
  UART_Sendf("Neutral hold %lu ms...\r\n", (unsigned long)START_HOLD_MS);
  HAL_Delay(START_HOLD_MS);

  UART_Sendf("WALK START\r\n");
  {
    uint32_t walk_start = HAL_GetTick();
    while ((HAL_GetTick() - walk_start) < WALK_DURATION_MS)
    {
      Walking_GaitTask(&pca, STEP_PERIOD_MS, +1);
      HAL_Delay(CONTROL_DT_MS);
    }
  }

  UART_Sendf("WALK DONE. Returning to neutral.\r\n");
  AllLegs_SetHipKneeNeutral(&pca);

  while (1)
  {
    HAL_Delay(500);
  }
}

