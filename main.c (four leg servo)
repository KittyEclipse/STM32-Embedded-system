/* ============================================================
   Math helpers
   ============================================================ */
static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float smoothstep(float x)
{
  x = clampf(x, 0.0f, 1.0f);
  return x * x * (3.0f - 2.0f * x);
}

static float apply_inv(float deg, int inv)
{
  return inv ? (180.0f - deg) : deg;
}

static float map_angle_to_pulse_us(float angle_deg, float min_us, float max_us)
{
  angle_deg = clampf(angle_deg, 0.0f, 180.0f);
  return min_us + (angle_deg / 180.0f) * (max_us - min_us);
}

/* ============================================================
   Low-level servo write
   ============================================================ */
static void set_servo_deg(PCA9685_Handle_t *hpca, uint8_t ch,
                          float deg, float min_us, float max_us)
{
  uint16_t us = (uint16_t)map_angle_to_pulse_us(deg, min_us, max_us);
  (void)PCA9685_SetServoPulseUs(hpca, ch, us);
}

/* ============================================================
   Per-leg angle processing
   ============================================================ */
static float process_hip(float deg, int local_inv, float trim, int global_inv)
{
  if (local_inv) deg = 180.0f - deg;
  deg += trim;
  deg = apply_inv(deg, global_inv);
  return clampf(deg, 0.0f, 180.0f);
}

static float process_knee(float deg, int local_inv, float trim, int global_inv)
{
  if (local_inv) deg = 180.0f - deg;
  deg += trim;
  deg = apply_inv(deg, global_inv);
  return clampf(deg, 0.0f, 180.0f);
}

/* ============================================================
   Leg setters
   ============================================================ */
static void FR_SetHipKnee(PCA9685_Handle_t *hpca, float hip, float knee)
{
  set_servo_deg(hpca, FR_HIP_CH,
                process_hip(hip, FR_HIP_LOCAL_INVERT, FR_HIP_TRIM_DEG, INV_HIP),
                HIP_MIN_US, HIP_MAX_US);
  set_servo_deg(hpca, FR_KNEE_CH,
                process_knee(knee, FR_KNEE_LOCAL_INVERT, FR_KNEE_TRIM_DEG, INV_KNEE),
                KNEE_MIN_US, KNEE_MAX_US);
}

static void FL_SetHipKnee(PCA9685_Handle_t *hpca, float hip, float knee)
{
  set_servo_deg(hpca, FL_HIP_CH,
                process_hip(hip, FL_HIP_LOCAL_INVERT, FL_HIP_TRIM_DEG, INV_HIP),
                HIP_MIN_US, HIP_MAX_US);
  set_servo_deg(hpca, FL_KNEE_CH,
                process_knee(knee, FL_KNEE_LOCAL_INVERT, FL_KNEE_TRIM_DEG, INV_KNEE),
                KNEE_MIN_US, KNEE_MAX_US);
}

static void BR_SetHipKnee(PCA9685_Handle_t *hpca, float hip, float knee)
{
  set_servo_deg(hpca, BR_HIP_CH,
                process_hip(hip, BR_HIP_LOCAL_INVERT, BR_HIP_TRIM_DEG, INV_HIP),
                HIP_MIN_US, HIP_MAX_US);
  set_servo_deg(hpca, BR_KNEE_CH,
                process_knee(knee, BR_KNEE_LOCAL_INVERT, BR_KNEE_TRIM_DEG, INV_KNEE),
                KNEE_MIN_US, KNEE_MAX_US);
}

static void BL_SetHipKnee(PCA9685_Handle_t *hpca, float hip, float knee)
{
  set_servo_deg(hpca, BL_HIP_CH,
                process_hip(hip, BL_HIP_LOCAL_INVERT, BL_HIP_TRIM_DEG, INV_HIP),
                HIP_MIN_US, HIP_MAX_US);
  set_servo_deg(hpca, BL_KNEE_CH,
                process_knee(knee, BL_KNEE_LOCAL_INVERT, BL_KNEE_TRIM_DEG, INV_KNEE),
