#define KNEE_MIN_US                900.0f
#define KNEE_MAX_US                2200.0f
#define EXT_MIN_US                 950.0f
#define EXT_MAX_US                 2050.0f

/* Neutral pose (logical degrees, before per-leg inversion) ------------------*/
#define FR_HIP_NEUTRAL_DEG         100.0f
#define FR_KNEE_NEUTRAL_DEG        0.0f
#define FR_EXT_NEUTRAL_DEG         55.0f

#define FL_HIP_NEUTRAL_DEG         100.0f
#define FL_KNEE_NEUTRAL_DEG        0.0f
#define FL_EXT_NEUTRAL_DEG         55.0f

#define BR_HIP_NEUTRAL_DEG         90.0f
#define BR_KNEE_NEUTRAL_DEG        90.0f

#define BL_HIP_NEUTRAL_DEG         90.0f
#define BL_KNEE_NEUTRAL_DEG        90.0f

/* Per-leg local inversion + trim --------------------------------------------*/
#define FR_HIP_LOCAL_INVERT        0
#define FR_HIP_TRIM_DEG            0.0f
#define FR_KNEE_LOCAL_INVERT       0
#define FR_KNEE_TRIM_DEG           0.0f

#define FL_HIP_LOCAL_INVERT        0
#define FL_HIP_TRIM_DEG            0.0f
#define FL_KNEE_LOCAL_INVERT       0
#define FL_KNEE_TRIM_DEG           0.0f

#define BR_HIP_LOCAL_INVERT        0
#define BR_HIP_TRIM_DEG            0.0f
#define BR_KNEE_LOCAL_INVERT       0
#define BR_KNEE_TRIM_DEG           0.0f

#define BL_HIP_LOCAL_INVERT        1
#define BL_HIP_TRIM_DEG            0.0f
#define BL_KNEE_LOCAL_INVERT       0
#define BL_KNEE_TRIM_DEG           0.0f

/* Global inversion (all legs) -----------------------------------------------*/
#define INV_HIP                    0
#define INV_KNEE                   0
#define INV_EXT                    0

/* Walking timing ------------------------------------------------------------*/
#define CONTROL_DT_MS              20U
#define STEP_PERIOD_MS             1500U
#define START_HOLD_MS              1500U
#define GAIT_RAMP_MS               2400U
#define WALK_DURATION_MS           10000U

/* Pair timing ---------------------------------------------------------------*/
#define PAIR_DELAY_PHASE           0.10f

/* Gait amplitudes -----------------------------------------------------------*/
#define HIP_SWING_AMPL_DEG         24.0f
#define KNEE_BEND_AMPL_DEG         38.0f
#define KNEE_STANCE_BEND_DEG       6.0f

/* UART ----------------------------------------------------------------------*/
#define UART_BYTE_TIMEOUT_MS       10U
#define UART_LINE_MAX              32

