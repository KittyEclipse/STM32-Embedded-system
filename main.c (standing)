  /* USER CODE END Init */

  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_I2C3_Init();
  MX_USART2_UART_Init();

  /* USER CODE BEGIN 2 */

  UART_Sendf("\r\nBOOT OK @115200\r\n");

  if (HAL_I2C_IsDeviceReady(&hi2c3, (PCA9685_ADDR_7BIT << 1), 5, 200) != HAL_OK) {
    UART_Sendf("ERROR: PCA9685 not found (I2C3 0x%02X)\r\n", PCA9685_ADDR_7BIT);
    Error_Handler();
  }
  if (PCA9685_Init(&pca, &hi2c3, PCA9685_ADDR_7BIT, 50.0f) != HAL_OK) {
    UART_Sendf("ERROR: PCA9685_Init failed\r\n");
    Error_Handler();
  }

  all_full_off();
  enable_all_servo_channels();
  set_extensions_neutral();
  UART_Sendf("PCA9685 OK\r\n");

  Gait_Init();
  Go_To_Neutral();
  UART_Sendf("Neutral.\r\n");

  set_stand();
  UART_Sendf("Standing. Waiting for GO from Jetson...\r\n");

  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  uint32_t last_tick = HAL_GetTick();

  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    UART_TxService();
    Handle_UART();
    Handle_Touch();

    uint32_t now = HAL_GetTick();
    uint32_t dt  = now - last_tick;
    if (dt >= CONTROL_DT_MS) {
      last_tick = now;
      Gait_Tick((float)dt);
    }
    /* USER CODE END 3 */
  }
}

