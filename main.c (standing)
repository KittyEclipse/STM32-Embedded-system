/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */

static float angle_to_us(float deg, float mn, float mx)
{ return mn + (deg / 180.0f) * (mx - mn); }

static void write_servo(uint8_t ch, float deg, float mn, float mx)
{
  (void)PCA9685_SetServoPulseUs(&pca, ch, (uint16_t)angle_to_us(deg, mn, mx));
}

static void stand(void)
{
  write_servo(FR_KNEE_CH, sitting_inital, KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BR_KNEE_CH, sitting_inital, KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FL_KNEE_CH, sitting_inital, KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BL_KNEE_CH, sitting_inital, KNEE_MIN_US, KNEE_MAX_US);
  HAL_Delay(500);

  for (float offset = sitting_inital; offset <= 70.0f; offset += 1.0f) {
    write_servo(FR_KNEE_CH, -offset, KNEE_MIN_US, KNEE_MAX_US);
    write_servo(BR_KNEE_CH, -offset, KNEE_MIN_US, KNEE_MAX_US);
    write_servo(FL_KNEE_CH, offset, KNEE_MIN_US, KNEE_MAX_US);
    write_servo(BL_KNEE_CH, offset, KNEE_MIN_US, KNEE_MAX_US);
    HAL_Delay(20);
  }
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_I2S3_Init();
  MX_SPI1_Init();
  MX_USB_HOST_Init();
  MX_I2C3_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();

  /* USER CODE BEGIN 2 */

  if (HAL_I2C_IsDeviceReady(&hi2c3, (PCA9685_ADDR_7BIT << 1), 5, 200) != HAL_OK)
    Error_Handler();

  if (PCA9685_Init(&pca, &hi2c3, PCA9685_ADDR_7BIT, 50.0f) != HAL_OK)
    Error_Handler();

  /* Extension channels stay off — not used */
  (void)PCA9685_SetChannelFullOff(&pca, FR_EXT_CH, 1);
  (void)PCA9685_SetChannelFullOff(&pca, FL_EXT_CH, 1);

  stand();

  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */
    MX_USB_HOST_Process();
    /* USER CODE BEGIN 3 */
    /* USER CODE END 3 */
  }
}

