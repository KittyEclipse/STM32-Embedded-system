/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_I2S3_Init();
  MX_SPI1_Init();
  MX_USB_HOST_Init();
  MX_I2C3_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();

  /* USER CODE BEGIN 2 */

  UART_Sendf("\r\nBOOT OK @115200\r\n");

  /* ---- PCA9685 (servo driver, I2C3) ---- */
  if (HAL_I2C_IsDeviceReady(&hi2c3, (PCA9685_ADDR_7BIT << 1), 5, 200) != HAL_OK) {
    UART_Sendf("ERROR: PCA9685 not found (I2C3 0x%02X)\r\n", PCA9685_ADDR_7BIT);
    Error_Handler();
  }
  if (PCA9685_Init(&pca, &hi2c3, PCA9685_ADDR_7BIT, 50.0f) != HAL_OK) {
    UART_Sendf("ERROR: PCA9685_Init failed\r\n");
    Error_Handler();
  }
  disable_extensions();
  all_full_off();
  UART_Sendf("PCA9685 OK\r\n");

  /* ---- Gait ---- */
  Gait_Init();
  Go_To_Neutral();

  /* ---- BL channel diagnostic ---- */
  {
    /* Flush TX ring so boot messages actually transmit before HAL_Delay */
    uint32_t t0 = HAL_GetTick();
    while ((uint32_t)(HAL_GetTick() - t0) < 10U) UART_TxService();

    HAL_StatusTypeDef bl_h = PCA9685_SetServoPulseUs(&pca, BL_HIP_CH,  1500U);
    HAL_StatusTypeDef bl_k = PCA9685_SetServoPulseUs(&pca, BL_KNEE_CH, 1500U);
    UART_Sendf("BL ch%u hip=%s ch%u knee=%s\r\n",
               (unsigned)BL_HIP_CH,  bl_h == HAL_OK ? "OK" : "FAIL",
               (unsigned)BL_KNEE_CH, bl_k == HAL_OK ? "OK" : "FAIL");
    /* Hold 1500us (midpoint) for 800ms so you can see if BL servos respond */
    t0 = HAL_GetTick();
    while ((uint32_t)(HAL_GetTick() - t0) < 800U) UART_TxService();
  }

  UART_Sendf("At neutral. Holding %ums...\r\n", (unsigned)START_HOLD_MS);
  { uint32_t t = HAL_GetTick();
    while ((uint32_t)(HAL_GetTick() - t) < START_HOLD_MS) UART_TxService(); }

  /* ---- BMI323 (IMU, I2C1) ---- */
  if (BMI323_Init(&imu, &hi2c1, BMI323_ADDR_7BIT) != HAL_OK) {
    UART_Sendf("WARN: BMI323 not found (I2C1 0x%02X) — IMU disabled\r\n",
               BMI323_ADDR_7BIT);
    /* Non-fatal: cat still walks and responds to touch */
  } else {
    UART_Sendf("BMI323 OK. Calibrating bias (robot must be still)...\r\n");
    /* 100 samples × 10 ms = ~1 second of stillness */
    (void)BMI323_CalibrateBias(&imu, 100, 10);
    UART_Sendf("IMU bias calibrated.\r\n");
    g_imu_last_report_ms = HAL_GetTick();
    g_imu_ok = 1;
  }

  /* ---- Touch sensors ---- */
  Touch_Init();

  /* Auto-start walking on power-on */
  Gait_Start();

  UART_Sendf("=== CAT ROBOT READY — WALKING ===\r\n");
  UART_Sendf("Cmds: GO FWD BACK LEFT RIGHT PIVOT_LEFT PIVOT_RIGHT STOP\r\n");
  UART_Sendf("Touch zones: HEAD CHIN BELLY BACK TAIL PAW_LEFT PAW_RIGHT\r\n");

  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  uint32_t last_tick = HAL_GetTick();

  while (1)
  {
    /* USER CODE END WHILE */
    MX_USB_HOST_Process();

    /* USER CODE BEGIN 3 */

    /* --- Drain TX ring buffer (non-blocking) --- */
    UART_TxService();

    /* --- Motion commands from Jetson --- */
    Handle_UART();

    /* --- Gait tick (rate-limited) --- */
    uint32_t now = HAL_GetTick();
    uint32_t dt  = now - last_tick;
    if (dt >= CONTROL_DT_MS) {
      last_tick = now;
      Gait_Tick((float)dt);
    }

    /* --- Touch sensor state machine --- */
    Touch_Tick();

    /* --- IMU stream to Jetson (skipped if BMI323 not present) --- */
    if (g_imu_ok) IMU_Tick();

    /* USER CODE END 3 */
  }
}

