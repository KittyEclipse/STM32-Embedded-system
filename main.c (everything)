/* Enqueue formatted string into the TX ring buffer. Bytes dropped if full. */
static void UART_Sendf(const char *fmt, ...)
{
  char buf[160];
  va_list ap;
  va_start(ap, fmt);
  int len = vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);
  if (len <= 0) return;
  if (len > (int)(sizeof(buf) - 1)) len = (int)(sizeof(buf) - 1);

  for (int i = 0; i < len; i++) {
    uint16_t next = (uart_tx_head + 1U) % UART_TX_BUF_SIZE;
    if (next != uart_tx_tail) {  /* drop silently if ring is full */
      uart_tx_buf[uart_tx_head] = (uint8_t)buf[i];
      uart_tx_head = next;
    }
  }
}

/* Drain the TX ring into the UART as fast as the hardware allows.
   Writes bytes while TXE (transmit data register empty) is set — no busy-wait,
   no blocking. Exits as soon as the DR is occupied or the ring is empty. */
static void UART_TxService(void)
{
  while (uart_tx_head != uart_tx_tail &&
         __HAL_UART_GET_FLAG(&huart2, UART_FLAG_TXE)) {
    huart2.Instance->DR = uart_tx_buf[uart_tx_tail];
    uart_tx_tail = (uart_tx_tail + 1U) % UART_TX_BUF_SIZE;
  }
}

static int UART_TryReadLine(char out[UART_LINE_MAX])
{
  static char    line[UART_LINE_MAX];
  static uint8_t idx = 0;
  uint8_t b = 0;
  if (HAL_UART_Receive(&huart2, &b, 1, UART_BYTE_TIMEOUT_MS) != HAL_OK)
    return 0;
  if (b == '\r') return 0;
  if (b == '\n') {
    line[idx] = '\0';
    strncpy(out, line, UART_LINE_MAX);
    out[UART_LINE_MAX-1] = '\0';
    idx = 0;
    return 1;
  }
  if (idx < UART_LINE_MAX-1) line[idx++] = (char)b;
  else idx = 0;
  return 0;
}

static void str_to_upper(char *s)
{ while (*s) { *s = (char)toupper((unsigned char)*s); s++; } }

/* =========================================================================
   Gait
   ========================================================================= */
static void Gait_Init(void)
{
  gait.running       = 0;
  gait.dir           = +1;
  gait.yaw           = 0.0f;
  gait.ramp_start_ms = 0;
  gait.t0            = 0;
}

static void gait_compute_leg(float phase, float hip_n, float knee_n,
                              float dir, float amp,
                              float *hip_out, float *knee_out)
{
  float hip, knee;
  if (phase < STANCE_END_PHASE) {
    float u = smoothstep(phase / STANCE_END_PHASE);
    hip  = hip_n - dir * amp * (2.0f * u - 1.0f);
    knee = knee_n + KNEE_STANCE_BEND;
  } else {
    float u    = (phase - STANCE_END_PHASE) / (1.0f - STANCE_END_PHASE);
    float s    = smoothstep(u);
    float lift = (u < 0.5f) ? smoothstep(u * 2.0f) : smoothstep((1.0f - u) * 2.0f);
    hip  = hip_n + dir * amp * (2.0f * s - 1.0f);
    knee = knee_n + KNEE_BEND_AMP * lift;
  }
  *hip_out  = clampf(hip,  0.0f, 180.0f);
  *knee_out = clampf(knee, 0.0f, 180.0f);
}

static void Gait_Tick(float dt_ms)
{
  (void)dt_ms;
  if (!gait.running) return;

  uint32_t now = HAL_GetTick();
  if (gait.t0 == 0) gait.t0 = now;

  float phase_a = (float)((now - gait.t0) % STEP_PERIOD_MS) / (float)STEP_PERIOD_MS;
  float phase_b = phase_a + PAIR_DELAY_PHASE;
  if (phase_b >= 1.0f) phase_b -= 1.0f;

  float ramp = smoothstep(clampf((float)(now - gait.ramp_start_ms)
                                 / (float)GAIT_RAMP_MS, 0.0f, 1.0f));
  float dir = (float)gait.dir;

  float a_dir, b_dir, a_amp, b_amp;
  if (dir == 0.0f) {
    a_dir = gait.yaw;      b_dir = -gait.yaw;
    a_amp = HIP_SWING_AMP; b_amp = HIP_SWING_AMP;
  } else {
    a_amp = HIP_SWING_AMP * clampf(1.0f + gait.yaw, 0.0f, 2.0f);
    b_amp = HIP_SWING_AMP * clampf(1.0f - gait.yaw, 0.0f, 2.0f);
    a_dir = dir; b_dir = dir;
  }

  float fr_hip, fr_knee, bl_hip, bl_knee;
  float fl_hip, fl_knee, br_hip, br_knee;

  gait_compute_leg(phase_a, FR_HIP_NEUTRAL + FR_HIP_TRIM, FR_KNEE_NEUTRAL + FR_KNEE_TRIM,
                   a_dir, a_amp, &fr_hip, &fr_knee);
  gait_compute_leg(phase_a, BL_HIP_NEUTRAL + BL_HIP_TRIM, BL_KNEE_NEUTRAL + BL_KNEE_TRIM,
                   a_dir, a_amp, &bl_hip, &bl_knee);
  gait_compute_leg(phase_b, FL_HIP_NEUTRAL + FL_HIP_TRIM, FL_KNEE_NEUTRAL + FL_KNEE_TRIM,
                   b_dir, b_amp, &fl_hip, &fl_knee);
  gait_compute_leg(phase_b, BR_HIP_NEUTRAL + BR_HIP_TRIM, BR_KNEE_NEUTRAL + BR_KNEE_TRIM,
                   b_dir, b_amp, &br_hip, &br_knee);

#define RAMP(val, n) ((n) + ramp * ((val) - (n)))
  fr_hip  = RAMP(fr_hip,  FR_HIP_NEUTRAL  + FR_HIP_TRIM);
  fr_knee = RAMP(fr_knee, FR_KNEE_NEUTRAL + FR_KNEE_TRIM);
  bl_hip  = RAMP(bl_hip,  BL_HIP_NEUTRAL  + BL_HIP_TRIM);
  bl_knee = RAMP(bl_knee, BL_KNEE_NEUTRAL + BL_KNEE_TRIM);
  fl_hip  = RAMP(fl_hip,  FL_HIP_NEUTRAL  + FL_HIP_TRIM);
  fl_knee = RAMP(fl_knee, FL_KNEE_NEUTRAL + FL_KNEE_TRIM);
  br_hip  = RAMP(br_hip,  BR_HIP_NEUTRAL  + BR_HIP_TRIM);
  br_knee = RAMP(br_knee, BR_KNEE_NEUTRAL + BR_KNEE_TRIM);
#undef RAMP

  write_servo(FL_HIP_CH,  apply_inv(fl_hip,  0), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FL_KNEE_CH, apply_inv(fl_knee, 0), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BL_HIP_CH,  apply_inv(bl_hip,  1), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BL_KNEE_CH, apply_inv(bl_knee, 0), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FR_HIP_CH,  apply_inv(fr_hip,  0), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FR_KNEE_CH, apply_inv(fr_knee, 0), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BR_HIP_CH,  apply_inv(br_hip,  0), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BR_KNEE_CH, apply_inv(br_knee, 0), KNEE_MIN_US, KNEE_MAX_US);
}

static void Go_To_Neutral(void)
{
  write_servo(FL_HIP_CH,  apply_inv(FL_HIP_NEUTRAL  + FL_HIP_TRIM,  0), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FL_KNEE_CH, apply_inv(FL_KNEE_NEUTRAL + FL_KNEE_TRIM, 0), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BL_HIP_CH,  apply_inv(BL_HIP_NEUTRAL  + BL_HIP_TRIM,  1), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BL_KNEE_CH, apply_inv(BL_KNEE_NEUTRAL + BL_KNEE_TRIM, 0), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(FR_HIP_CH,  apply_inv(FR_HIP_NEUTRAL  + FR_HIP_TRIM,  0), HIP_MIN_US,  HIP_MAX_US);
  write_servo(FR_KNEE_CH, apply_inv(FR_KNEE_NEUTRAL + FR_KNEE_TRIM, 0), KNEE_MIN_US, KNEE_MAX_US);
  write_servo(BR_HIP_CH,  apply_inv(BR_HIP_NEUTRAL  + BR_HIP_TRIM,  0), HIP_MIN_US,  HIP_MAX_US);
  write_servo(BR_KNEE_CH, apply_inv(BR_KNEE_NEUTRAL + BR_KNEE_TRIM, 0), KNEE_MIN_US, KNEE_MAX_US);
}

static void Gait_Start(void)
{
  gait.running       = 1;
  gait.ramp_start_ms = HAL_GetTick();
  gait.t0            = 0;
}

static void Handle_UART(void)
{
  char rx[UART_LINE_MAX];
  if (!UART_TryReadLine(rx)) return;
  str_to_upper(rx);

  if (strcmp(rx, TOKEN_GO) == 0 || strcmp(rx, TOKEN_FWD) == 0) {
    gait.dir = +1; gait.yaw = 0.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("FWD\r\n");
  } else if (strcmp(rx, TOKEN_BACK) == 0) {
    gait.dir = -1; gait.yaw = 0.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("BACK\r\n");
  } else if (strcmp(rx, TOKEN_LEFT) == 0) {
    gait.yaw = -1.0f;
    if (gait.dir == 0) gait.dir = +1;
    if (!gait.running) Gait_Start();
    UART_Sendf("LEFT\r\n");
  } else if (strcmp(rx, TOKEN_RIGHT) == 0) {
    gait.yaw = +1.0f;
    if (gait.dir == 0) gait.dir = +1;
    if (!gait.running) Gait_Start();
    UART_Sendf("RIGHT\r\n");
  } else if (strcmp(rx, "PIVOT_LEFT") == 0) {
    gait.dir = 0; gait.yaw = -1.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("PIVOT_LEFT\r\n");
  } else if (strcmp(rx, "PIVOT_RIGHT") == 0) {
    gait.dir = 0; gait.yaw = +1.0f;
    if (!gait.running) Gait_Start();
    UART_Sendf("PIVOT_RIGHT\r\n");
  } else if (strcmp(rx, TOKEN_STOP) == 0) {
    gait.running       = 0;
    gait.dir           = +1;
    gait.yaw           = 0.0f;
    gait.ramp_start_ms = 0;
    gait.t0            = 0;
    Go_To_Neutral();
    UART_Sendf("STOP ACK\r\n");
  } else {
    UART_Sendf("UNKNOWN: '%s'\r\n", rx);
  }
}

/* =========================================================================
   Touch sensors
   =========================================================================
   TTP223 output: HIGH = touched, LOW = not touched.
   State machine per sensor:
     IDLE      → pin goes HIGH  → enter DEBOUNCE, record press_ms
     DEBOUNCE  → pin still HIGH after TOUCH_DEBOUNCE_MS → enter ACTIVE
     DEBOUNCE  → pin goes LOW   → back to IDLE (noise)
     ACTIVE    → held > HOLD_THRESH_MS → enter HOLD, send "TOUCH x HOLD"
     ACTIVE    → pin goes LOW   → send "TOUCH x", back to IDLE (tap)
     HOLD      → pin goes LOW   → send "TOUCH x RELEASE", back to IDLE
   ========================================================================= */
static void Touch_Init(void)
{
  for (int i = 0; i < (int)TOUCH_COUNT; i++) {
    g_touch[i].state     = TOUCH_IDLE;
    g_touch[i].press_ms  = 0;
    g_touch[i].hold_sent = 0;
  }
}

static void Touch_Tick(void)
{
  uint32_t now = HAL_GetTick();

  for (int i = 0; i < (int)TOUCH_COUNT; i++) {
    TouchSensor *t   = &g_touch[i];
    uint8_t      pin_hi = (HAL_GPIO_ReadPin(t->port, t->pin) == GPIO_PIN_SET)
                          ? 1u : 0u;

    switch (t->state) {

      case TOUCH_IDLE:
        if (pin_hi) {
          t->state    = TOUCH_DEBOUNCE;
          t->press_ms = now;
        }
        break;

      case TOUCH_DEBOUNCE:
        if (!pin_hi) {
          /* Glitch — ignore */
          t->state = TOUCH_IDLE;
        } else if ((now - t->press_ms) >= TOUCH_DEBOUNCE_MS) {
          t->state     = TOUCH_ACTIVE;
          t->hold_sent = 0;
        }
        break;

      case TOUCH_ACTIVE:
        if (!pin_hi) {
          /* Tap: released before hold threshold */
          UART_Sendf("TOUCH %s\r\n", t->name);
          t->state = TOUCH_IDLE;
        } else if (!t->hold_sent &&
                   (now - t->press_ms) >= HOLD_THRESH_MS) {
          /* Crossed hold threshold */
          UART_Sendf("TOUCH %s HOLD\r\n", t->name);
          t->hold_sent = 1;
          t->state     = TOUCH_HOLD;
        }
        break;

      case TOUCH_HOLD:
        if (!pin_hi) {
          /* Released after hold */
          UART_Sendf("TOUCH %s RELEASE\r\n", t->name);
          t->state = TOUCH_IDLE;
        }
        break;

      default:
        t->state = TOUCH_IDLE;
        break;
    }
  }
}

/* =========================================================================
   IMU tick — read BMI323 and send to Jetson over UART2 every IMU_REPORT_MS
   ========================================================================= */
static void IMU_Tick(void)
{
  uint32_t now = HAL_GetTick();
  if ((now - g_imu_last_report_ms) < IMU_REPORT_MS) return;
  g_imu_last_report_ms = now;

  BMI323_Sample_t s;
  if (BMI323_ReadSample(&imu, &s) != HAL_OK) {
    UART_Sendf("IMU ERROR\r\n");
    return;
  }

  /* Format: "IMU ax ay az gx gy gz\r\n" with 3 decimal places.
     Hand-formatted to avoid depending on -u _printf_float (not present in
     this nano.specs build). Each field: [-]int.frac. */
  #define FMT_F3(v) \
    ((v) < 0.0f ? "-" : ""), \
    (int)((v) < 0.0f ? -(v) : (v)), \
    (int)(((v) < 0.0f ? -(v) : (v)) * 1000.0f + 0.5f) % 1000

  UART_Sendf("IMU %s%d.%03d %s%d.%03d %s%d.%03d"
             " %s%d.%03d %s%d.%03d %s%d.%03d\r\n",
             FMT_F3(s.acc_g[0]),   FMT_F3(s.acc_g[1]),   FMT_F3(s.acc_g[2]),
             FMT_F3(s.gyr_dps[0]), FMT_F3(s.gyr_dps[1]), FMT_F3(s.gyr_dps[2]));
  #undef FMT_F3
}

