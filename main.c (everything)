/* =========================================================================
   Math helpers
   ========================================================================= */
static float clampf(float v, float lo, float hi)
{ return (v < lo) ? lo : (v > hi) ? hi : v; }

static float smoothstep(float x)
{ x = clampf(x,0.0f,1.0f); return x*x*(3.0f - 2.0f*x); }

/* =========================================================================
   Servo helpers
   ========================================================================= */
static float apply_inv(float deg, int inv)
{ return inv ? (180.0f - deg) : deg; }

static float angle_to_us(float deg, float mn, float mx)
{ deg = clampf(deg,0.0f,180.0f); return mn + (deg/180.0f)*(mx-mn); }

static void write_servo(uint8_t ch, float deg, float mn, float mx)
{
  if (PCA9685_SetServoPulseUs(&pca, ch, (uint16_t)angle_to_us(deg,mn,mx)) != HAL_OK) {
    if (++g_servo_faults >= SERVO_FAULT_MAX) {
      gait.running = 0;
      UART_Sendf("SERVO FAULT ch%u: I2C error, gait stopped\r\n", (unsigned)ch);
    }
  } else {
    g_servo_faults = 0;
  }
}

static void all_full_off(void)
{
  uint8_t chs[] = { FR_HIP_CH, FR_KNEE_CH, FR_EXT_CH,
                    FL_HIP_CH, FL_KNEE_CH, FL_EXT_CH,
                    BR_HIP_CH, BR_KNEE_CH,
                    BL_HIP_CH, BL_KNEE_CH };
  for (int i = 0; i < (int)(sizeof(chs)/sizeof(chs[0])); i++)
    (void)PCA9685_SetChannelFullOff(&pca, chs[i], 1);
}

static void disable_extensions(void)
{
  (void)PCA9685_SetChannelFullOff(&pca, FR_EXT_CH, 1);
  (void)PCA9685_SetChannelFullOff(&pca, FL_EXT_CH, 1);
}

/* =========================================================================
   Back-leg test helpers
   ========================================================================= */

/* Write a servo pulse directly in microseconds. Clamps to 900–2200 µs. */
static void write_servo_us(uint8_t ch, float us)
{
  us = clampf(us, 900.0f, 2200.0f);
  if (PCA9685_SetServoPulseUs(&pca, ch, (uint16_t)us) != HAL_OK) {
    if (++g_servo_faults >= SERVO_FAULT_MAX) {
      gait.running = 0;
      UART_Sendf("SERVO FAULT ch%u\r\n", (unsigned)ch);
    }
  } else {
    g_servo_faults = 0;
  }
}

/* Back-leg test gait — BR (ch 6/7) and BL (ch 14/15) only.
 *
 * Hip  : full 900–2200 µs sweep (wide step).
 *        Tune BR_HIP_NEUTRAL_US / BL_HIP_NEUTRAL_US so the leg hangs level.
 *
 * Knee : kick-back pattern —
 *        first half of swing : bends up   (foot clears ground)
 *        second half         : kicks back past neutral (cat push-off)
 *        stance              : holds neutral
 */
static void BackLeg_Tick(float dt_ms)
{
  if (!gait.running) return;

  g_test_swing_ph += dt_ms / (float)TEST_SWING_MS;
  if (g_test_swing_ph >= 1.0f) {
    g_test_swing_leg ^= 1u;   /* BR → BL → BR ... */
    g_test_swing_ph   = 0.0f;
  }

  float s = smoothstep(g_test_swing_ph);

  for (int leg = 0; leg < 2; leg++) {
    uint8_t hip_ch   = (leg == 0) ? BR_HIP_CH          : BL_HIP_CH;
    uint8_t knee_ch  = (leg == 0) ? BR_KNEE_CH         : BL_KNEE_CH;
    float   hip_n    = (leg == 0) ? BR_HIP_NEUTRAL_US  : BL_HIP_NEUTRAL_US;
    float   knee_n   = (leg == 0) ? BR_KNEE_NEUTRAL_US : BL_KNEE_NEUTRAL_US;
    /* BL hip servo is physically mirrored: invert sweep direction */
    float   hip_dir  = (leg == 0) ? +1.0f : (BL_HIP_INVERTED ? -1.0f : +1.0f);
    float   hip_us, knee_us;

    if (leg == (int)g_test_swing_leg) {
      /* Swing: hip sweeps neutral ± AMP (direction inverted for BL) */
      hip_us = hip_n + hip_dir * TEST_HIP_AMP_US * (2.0f * s - 1.0f);

      /* Knee kick-back:
         ph 0→0.5 : bends up from neutral (clearance)
         ph 0.5→1 : kicks back past neutral (push-off) */
      float ko;
      if (g_test_swing_ph < 0.5f) {
        ko = TEST_KNEE_AMP_US * smoothstep(g_test_swing_ph * 2.0f);
      } else {
        ko = TEST_KNEE_AMP_US * (1.0f - 2.0f * smoothstep((g_test_swing_ph - 0.5f) * 2.0f));
      }
      knee_us = knee_n + ko;
    } else {
      /* Stance: hold neutral */
      hip_us  = hip_n;
      knee_us = knee_n;
    }

    write_servo_us(hip_ch,  hip_us);
    write_servo_us(knee_ch, knee_us);
  }
}

