/**
  ******************************************************************************
  * @file           : main.c
  * @brief          : STM32F407 — Cat robot main firmware
  *
  * Features:
  *   1. Sequential diagonal gait (FR→BL→FL→BR) via PCA9685 on I2C3
  *   2. TTP223 touch sensors on GPIOE — tap & hold detection, 7 zones
  *   3. BMI323 IMU on I2C1 — 100Hz accel+gyro, reported to Jetson at 20Hz (IMU_REPORT_MS=50)
